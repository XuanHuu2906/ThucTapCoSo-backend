# App
NODE_ENV=development
PORT=5000

# Database (PostgreSQL - Prisma schema uses postgresql)
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"
DIRECT_URL="postgresql://username:password@localhost:5432/database_name?schema=public"

# JWT
JWT_SECRET=your-super-secret-key-min-32-chars-here
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (Dùng cho upload CV)
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name

# Resend Email Service (Cần thiết để gửi mail)
RESEND_API_KEY=re_your-resend-api-key-here

# Frontend URL (Dùng để sinh link xác nhận/phản hồi gửi cho ứng viên trong email)
# Cần cấu hình chính xác địa chỉ frontend đang chạy (VD: http://localhost:5173 hoặc IP máy nếu test trên điện thoại)
FRONTEND_URL=http://localhost:5173
